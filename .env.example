# Direct connection — used by the migration script (scripts/migrate.ts).
# DDL through a transaction-mode pooler can misbehave, so migrations bypass it.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Pooled connection — used by the app (src/db.ts).
# Serverless functions open many short-lived connections; the pooler absorbs them.
DATABASE_URL_POOLED="postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Session signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# Gmail SMTP for password-reset emails. Requires 2FA on the Google account and
# an App Password (not your normal password). If unset, reset links are logged
# to the server console instead of emailed.
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
